# Arctic Shift
ARCTIC_SHIFT_BASE=https://arctic-shift.photon-reddit.com
POSTS_PER_QUERY=20
COMMENTS_PER_THREAD=5



# Reddit Research MCP
REDDIT_MCP_URL=https://mcp.dialog.tools/mcp
# MCP semantic community discovery
MCP_COMMUNITY_LIMIT=10
# Minimum semantic confidence for discovered communities
MCP_MIN_CONFIDENCE=0.50
# Number of posts retrieved per discovered subreddit
MCP_POSTS_PER_SUBREDDIT=10


# Agent-Reach / rdt
AGENT_REACH_ENABLED=true
AGENT_REACH_TIMEOUT=60

# Small delay between requests to avoid hammering sources
REQUEST_DELAY=0.5