REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Free, local, open-weight outreach generator (Ollama).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=25
OLLAMA_WARMUP=true

# Optional shared cache. Use the Project URL and service_role key from Supabase.
# Keep this backend-only; never use the anon/publishable key here or in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Backward-compatible alias; prefer SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_KEY=
ANALYSIS_CACHE_TTL_SECONDS=600

REDDIT_SOURCE=arcticshift
ARCTIC_SHIFT_BASE=https://arctic-shift.photon-reddit.com/api
REDDIT_DISCOVERY_SOURCE=websearch
